# ===========================
# Chatrah Backend — Environment Variables
# ===========================
# Copy this file to .env and fill in real values.
# See CREDENTIALS_GUIDE.md for detailed instructions.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/chatrah
DB_USERNAME=postgres
DB_PASSWORD=root

# --- JWT Keys (paths to PEM files) ---
JWT_PUBLIC_KEY_LOCATION=publicKey.pem
JWT_PRIVATE_KEY_LOCATION=privateKey_pkcs8.pem

# --- Email (Gmail with App Password) ---
SMTP_FROM=youremail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=jinukalaraneesh3@gmail.com
SMTP_PASSWORD=
SMTP_MOCK=true

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourTestSecretHere
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- SMS (MSG91) ---
SMS_PROVIDER=mock
SMS_ENABLED=false
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=CHATRAH
MSG91_TEMPLATE_ID=your_template_id

# --- Attendance Alerts ---
ATTENDANCE_ALERT_ENABLED=false
ATTENDANCE_THRESHOLD=75
